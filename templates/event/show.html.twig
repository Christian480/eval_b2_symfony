{% extends 'base.html.twig' %}

{% block title %}{{ event.title }}{% endblock %}

{% block body %}
    <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>

    {# Création de la classe CSS basée sur la catégorie (comme sur l'accueil) #}
    {% set css_cat = event.category|lower|replace({'é': 'e'}) %}
    
    <article class="cat-{{ css_cat }}">
        {# Gestion de l'image de fond : image uploadée OU image par défaut de la catégorie #}
        {% if event.image %}
            <header class="detail-hero" style="background-image: url('{{ asset('images/' ~ event.image) }}')">
        {% else %}
            <header class="detail-hero" style="background-image: url('{{ asset('images/' ~ css_cat ~ '.jpg') }}')">
        {% endif %}
            <div class="detail-hero-content">
                <span class="badge">{{ event.category }}</span>
                <h1>{{ event.title }}</h1>
                <p>{{ event.date|date('d/m/Y · H\\hi') }}</p>
            </div>
        </header>

        <div class="detail-grid">
            <section class="card">
                <h2>Informations</h2>
                {# Le filtre nl2br permet de respecter les retours à la ligne saisis dans le formulaire #}
                <p>{{ event.informations|nl2br }}</p>
            </section>

            <aside class="card booking">
                {# Calcul des places restantes #}
                {% set places_reservees = event.participants|length %}
                {% set places_restantes = event.seats - places_reservees %}
                {% set pourcentage_remplissage = (event.seats > 0) ? (places_reservees / event.seats) * 100 : 0 %}

                <p class="places"><strong>{{ places_restantes }}</strong> places restantes sur {{ event.seats }}</p>
                <div class="progress"><span style="width: {{ pourcentage_remplissage }}%"></span></div>

                {% if places_restantes <= 0 and not (app.user and event.participants.contains(app.user)) %}
                    {# Si c'est complet et que l'utilisateur n'est pas déjà inscrit #}
                    <p class="places"><span class="badge badge-full">Complet</span></p>
                    <button class="btn btn-block" disabled>Complet</button>
                
                {% elseif not app.user %}
                    {# Si l'utilisateur n'est pas connecté #}
                    <a class="btn btn-block" href="{{ path('app_login') }}">Connectez-vous pour vous inscrire</a>
                
                {% else %}
                    {# Si l'utilisateur est connecté #}
                    <form method="post">
                        {% if event.participants.contains(app.user) %}
                            <p class="muted" style="margin-bottom: 10px;">Vous êtes inscrit à cet événement.</p>
                            <button type="submit" class="btn btn-secondary btn-block">Se désinscrire</button>
                        {% else %}
                            <button type="submit" class="btn btn-block">S'inscrire</button>
                        {% endif %}
                    </form>
                {% endif %}
            </aside>
        </div>
    </article>
{% endblock %}