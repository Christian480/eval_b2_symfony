{% extends 'base.html.twig' %}

{% block title %}Événements à venir{% endblock %}

{% block body %}
    <section class="hero" style="background-image: url('{{ asset('images/rock.jpg') }}')">
        <div class="hero-content">
            <span class="hero-kicker">Agenda local</span>
            <h1>Les événements près de chez vous</h1>
            <p>Concerts, conférences, ateliers et sport : trouvez votre prochaine sortie ou proposez la vôtre.</p>
            <a class="btn" href="{{ path('app_event_new') }}">+ Ajouter un événement</a>
        </div>
    </section>

    <div class="section-head">
        <h2>À venir</h2>
      <ul class="legend">
    <li><a class="{% if not currentCategory %}active{% endif %}" href="{{ path('app_home') }}">Toutes</a></li>
    <li class="cat-concert"><a class="{% if currentCategory == 'Concert' %}active{% endif %}" href="{{ path('app_home', {categorie: 'Concert'}) }}">Concert</a></li>
    <li class="cat-conference"><a class="{% if currentCategory == 'Conférence' %}active{% endif %}" href="{{ path('app_home', {categorie: 'Conférence'}) }}">Conférence</a></li>
    <li class="cat-atelier"><a class="{% if currentCategory == 'Atelier' %}active{% endif %}" href="{{ path('app_home', {categorie: 'Atelier'}) }}">Atelier</a></li>
    <li class="cat-sport"><a class="{% if currentCategory == 'Sport' %}active{% endif %}" href="{{ path('app_home', {categorie: 'Sport'}) }}">Sport</a></li>
</ul>

    <ul class="event-list">
        {% for event in events %}
            {% set css_cat = event.category|lower|replace({'é': 'e'}) %}
            
            <li class="event-card cat-{{ css_cat }}">
                <div class="event-media">
                   {% if event.image %}
    <img class="event-image" src="{{ asset('images/' ~ event.image) }}" alt="{{ event.title }}">
{% else %}
    <img class="event-image" src="{{ asset('images/' ~ css_cat ~ '.jpg') }}" alt="{{ event.title }}">
{% endif %}
                    
                    <div class="event-date">
                        <span class="day">{{ event.date|date('d') }}</span>
                        <span class="month">{{ event.date|date('M')|trim('.') }}</span>
                    </div>
                    
                    <span class="badge">{{ event.category }}</span>
                </div>
                
                <h3 class="event-title">
                    <a href="{{ path('app_event_show', {id: event.id}) }}">{{ event.title }}</a>
                </h3>
                <span class="muted">{{ event.date|date('d/m/Y · H\\hi') }}</span>
            </li>
        {% else %}
            <p class="empty">Aucun événement à venir pour le moment.</p>
        {% endfor %}
    </ul>
{% endblock %}